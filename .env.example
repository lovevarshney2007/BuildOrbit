# BuildOrbit — Environment Variables Template
#
# Copy this file to .env and fill in the real values.
# NEVER commit .env to Git. Only .env.example is committed.
#
# ============================================================
# DATABASE
# ============================================================

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (local development): postgresql://postgres:yourpassword@localhost:5432/buildorbit?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/buildorbit?schema=public"

# ============================================================
# AUTHENTICATION
# ============================================================

# Secret key for signing JWT tokens or session cookies.
# Must be a long, random string (minimum 32 characters).
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# The base URL of the application (used by NextAuth and absolute URL generation).
# In development this is typically http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# DEVELOPMENT SEED CREDENTIALS
# ============================================================
# Used ONLY by: npx prisma db seed
# These credentials are used to create the initial SUPER_ADMIN account.
# Set these only in your local .env. Never use real credentials here.

SEED_ADMIN_EMAIL="admin@buildorbit.dev"
SEED_ADMIN_PASSWORD=""

# ============================================================
# APPLICATION
# ============================================================

# Node environment (development | production | test)
NODE_ENV="development"
RESEND_API_KEY="your_resend_api_key_here"
