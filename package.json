{
  "name": "buildorbit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "dotenv -e .env.test -- npx prisma db push --accept-data-loss && dotenv -e .env.test -- npx playwright test --project=setup --project=chromium-main --project=chromium-unauthenticated",
    "test:e2e:all": "dotenv -e .env.test -- npx prisma db push --accept-data-loss && dotenv -e .env.test -- npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report playwright-report",
    "test:e2e:setup": "npx playwright test --project=setup",
    "test:e2e:routes": "npx playwright test tests/e2e/02-routes.test.ts",
    "test:e2e:auth": "npx playwright test tests/e2e/01-auth.test.ts",
    "test:e2e:rbac": "npx playwright test tests/e2e/03-rbac.test.ts",
    "test:e2e:crud": "npx playwright test tests/e2e/04-employee-crud.test.ts tests/e2e/05-leave.test.ts tests/e2e/06-payroll.test.ts tests/e2e/07-crm.test.ts",
    "test:e2e:workflows": "npx playwright test tests/e2e/08-workflows.test.ts",
    "test:e2e:headed": "npx playwright test --headed --project=chromium-main",
    "test": "npm run test:e2e"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "face-api.js": "^0.22.2",
    "framer-motion": "^13.4.6",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.11.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "resend": "^6.30.0",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^5.22.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
