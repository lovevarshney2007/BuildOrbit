// BuildOrbit — Prisma Schema (Full)
// Database: PostgreSQL | ORM: Prisma 5.22.0
// See docs/DATABASE.md for documentation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  HR
  LEAD
  ENGINEER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}

// Business category of a leave type. Drives reporting buckets (e.g. "Medical Leave").
enum LeaveCategory {
  GENERAL
  MEDICAL
  OTHER
}

// Payroll effect of an approved leave of this type (configured in Leave Master).
enum LeavePayrollImpact {
  NONE // no salary deduction (paid leave)
  DEDUCTION // deduct `payrollDeductionPercent` of the daily rate per leave day
}

enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveDocumentType {
  PRESCRIPTION
  MEDICAL_CERTIFICATE
  DOCTOR_NOTE
  HOSPITAL_DOCUMENT
  MEDICAL_REPORT
  OTHER
}

enum AttendanceMethod {
  GEOFENCE // GPS verified against the assigned site
  MANUAL // created/edited by an authorised user
  LEAVE_SYSTEM // generated from an approved leave
  LEGACY // pre-geofence records
}

enum PayrollDivisorMode {
  CALENDAR_DAYS
  WORKING_DAYS
  FIXED
}

enum PayrollRounding {
  NONE
  ROUND
  FLOOR
  CEIL
}

enum PayrollAdjustmentStatus {
  PENDING // waiting to be applied (explicit recalculation or carried into next draft payroll)
  APPLIED
  DISMISSED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL
  COLD_CALL
  EVENT
  OTHER
}

// ===========================================================================
// Core / Auth
// ===========================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(ENGINEER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  employee        Employee?
  loginActivities LoginActivity[]
  leaveRequests   LeaveRequest[]  @relation("RequesterLeaveRequests")
  approvedLeaves  LeaveRequest[]  @relation("ApproverLeaveRequests")
  assignedLeads   Lead[]          @relation("AssignedLeads")
  createdLeads    Lead[]          @relation("CreatedLeads")
  auditLogs       AuditLog[]
  notifications   Notification[]
  uploadedDocs    EmployeeDocument[] @relation("UploadedDocs")

  @@index([email])
  @@index([role])
  @@map("users")
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  email     String
  role      Role
  ipAddress String?
  userAgent String?
  browser   String?
  os        String?
  device    String?
  loginAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@map("login_activities")
}

// ===========================================================================
// Organization Structure
// ===========================================================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("departments")
}

model Designation {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("designations")
}

// ===========================================================================
// Workforce
// ===========================================================================

model Employee {
  id            String         @id @default(cuid())
  userId        String         @unique
  employeeCode  String         @unique
  phone         String?
  address       String?
  dateOfBirth   DateTime?
  joiningDate   DateTime
  departmentId  String?
  designationId String?
  teamId        String?
  status        EmployeeStatus @default(ACTIVE)
  basicSalary   Decimal        @default(0) @db.Decimal(10, 2)
  faceDescriptor String?       @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department?              @relation(fields: [departmentId], references: [id])
  designation     Designation?             @relation(fields: [designationId], references: [id])
  team            Team?                    @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeams        Team[]                   @relation("TeamLead")
  attendances     Attendance[]
  leaveBalances   LeaveBalance[]
  leaveDocuments  LeaveDocument[]
  employeeDocs    EmployeeDocument[] @relation("EmployeeDocs")
  payrolls        Payroll[]
  siteAssignments EmployeeSiteAssignment[]
  shiftAssignments ShiftAssignment[]

  @@index([departmentId])
  @@index([teamId])
  @@index([status])
  @@map("employees")
}

// ===========================================================================
// Teams, Sites and Site Assignment (geo-fenced attendance)
// ===========================================================================

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  leadId      String? // Employee who leads the team (team/attendance visibility for LEAD role)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead            Employee?            @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members         Employee[]           @relation("TeamMembers")
  siteAssignments TeamSiteAssignment[]

  @@index([leadId])
  @@map("teams")
}

model Site {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  address      String?
  latitude     Float
  longitude    Float
  radiusMeters Int // geofence radius
  isActive     Boolean  @default(true)
  projectName  String? // project / client
  region       String? // region / zone
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employeeAssignments EmployeeSiteAssignment[]
  teamAssignments     TeamSiteAssignment[]
  attendances         Attendance[]

  @@index([isActive])
  @@map("sites")
}

// Individual assignment — takes precedence over team assignment.
model EmployeeSiteAssignment {
  id             String    @id @default(cuid())
  employeeId     String
  siteId         String
  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([employeeId, isActive])
  @@index([siteId])
  @@map("employee_site_assignments")
}

model TeamSiteAssignment {
  id             String    @id @default(cuid())
  teamId         String
  siteId         String
  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([teamId, isActive])
  @@index([siteId])
  @@map("team_site_assignments")
}

// ===========================================================================
// Attendance
// ===========================================================================

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  checkIn    DateTime?
  checkOut   DateTime?
  notes      String?
  source     AttendanceMethod @default(LEGACY)

  // Geofence verification (captured only at check-in / check-out, never tracked continuously)
  siteId                   String?
  latitude                 Float?
  longitude                Float?
  accuracyMeters           Float?
  distanceFromSite         Float?
  locationVerified         Boolean @default(false)
  checkOutLatitude         Float?
  checkOutLongitude        Float?
  checkOutAccuracyMeters   Float?
  checkOutDistanceFromSite Float?
  workedMinutes            Int?

  // Set when this row was produced by an approved leave
  leaveRequestId String?
  leaveTypeId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site         Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  leaveType    LeaveType?    @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([siteId])
  @@index([leaveRequestId])
  @@map("attendances")
}

// ===========================================================================
// Leave Management
// ===========================================================================

model LeaveType {
  id          String        @id @default(cuid())
  name        String        @unique
  code        String?       @unique
  description String?
  category    LeaveCategory @default(GENERAL)
  daysAllowed Int           @default(0) // annual allocation
  isPaid      Boolean       @default(true)
  isActive    Boolean       @default(true)

  // Balance policy
  tracksBalance       Boolean @default(true) // false = unlimited (e.g. loss-of-pay leave)
  carryForwardAllowed Boolean @default(false)
  carryForwardMaxDays Float   @default(0)

  // Request policy
  maxConsecutiveDays Int?
  requiresApproval   Boolean @default(true)
  allowHalfDay       Boolean @default(true)
  minServiceDays     Int     @default(0) // eligibility: days since joining
  applicableRoles    Role[] // empty = every role

  // Supporting document policy
  requiresDocument          Boolean @default(false)
  documentRequiredAfterDays Int? // when set, document needed only if request days > this value

  // Payroll policy
  payrollImpact           LeavePayrollImpact @default(NONE)
  payrollDeductionPercent Float              @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  attendances   Attendance[]

  @@map("leave_types")
}

// Balance model: remaining = totalDays - usedDays - pendingDays
//   PENDING request   -> pendingDays += days   (reservation)
//   APPROVED          -> pendingDays -= days, usedDays += days
//   REJECTED/CANCELLED(pending) -> pendingDays -= days
//   CANCELLED(approved) -> usedDays -= days
model LeaveBalance {
  id                 String   @id @default(cuid())
  employeeId         String
  leaveTypeId        String
  year               Int
  totalDays          Float
  usedDays           Float    @default(0)
  pendingDays        Float    @default(0)
  carriedForwardDays Float    @default(0) // portion of totalDays that was carried from last year
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String         @id @default(cuid())
  requesterId   String
  leaveTypeId   String
  startDate     DateTime       @db.Date
  endDate       DateTime       @db.Date
  days          Float // working days, 0.5 steps
  isHalfDay     Boolean        @default(false)
  halfDayPeriod HalfDayPeriod?
  reason        String
  status        LeaveStatus    @default(PENDING)
  approverId    String?
  approverNote  String?
  approvedAt    DateTime?
  cancelledAt   DateTime?
  cancelReason  String?

  // Policy snapshot taken at approval time so later Leave Master edits never rewrite history/payroll.
  paidSnapshot             Boolean?
  deductionPercentSnapshot Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester          User                @relation("RequesterLeaveRequests", fields: [requesterId], references: [id])
  approver           User?               @relation("ApproverLeaveRequests", fields: [approverId], references: [id])
  leaveType          LeaveType           @relation(fields: [leaveTypeId], references: [id])
  documents          LeaveDocument[]
  attendances        Attendance[]
  payrollAdjustments PayrollAdjustment[]

  @@index([requesterId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// Sensitive medical/supporting document. The file lives in PRIVATE storage (never public/).
model LeaveDocument {
  id               String            @id @default(cuid())
  leaveRequestId   String
  employeeId       String
  documentType     LeaveDocumentType
  originalFilename String
  storageKey       String            @unique // Can now hold Cloudinary public_id or secure_url
  mimeType         String
  sizeBytes        Int
  uploadedById     String
  uploadedAt       DateTime          @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId])
  @@index([employeeId])
  @@map("leave_documents")
}

// ===========================================================================
// Employee Documents (Identity, Background, Offer Letters)
// ===========================================================================

enum EmployeeDocumentType {
  ID_PROOF
  ADDRESS_PROOF
  OFFER_LETTER
  CONTRACT
  BANK_DETAILS
  RESUME
  OTHER
}

model EmployeeDocument {
  id               String               @id @default(cuid())
  employeeId       String
  documentType     EmployeeDocumentType
  title            String               // E.g., "Aadhar Card"
  originalFilename String
  storageKey       String               @unique // Cloudinary secure_url or public_id
  mimeType         String
  sizeBytes        Int
  uploadedById     String
  uploadedAt       DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  employee Employee @relation("EmployeeDocs", fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("UploadedDocs", fields: [uploadedById], references: [id])

  @@index([employeeId])
  @@map("employee_documents")
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())

  @@map("holidays")
}

// Single-row organisation configuration (id is always "default").
model OrganizationPolicy {
  id                       String             @id @default("default")
  timezone                 String             @default("Asia/Kolkata")
  weeklyOffDays            Int[]              @default([0, 6]) // 0 = Sunday ... 6 = Saturday
  payrollDivisorMode       PayrollDivisorMode @default(CALENDAR_DAYS)
  payrollFixedDivisor      Int                @default(30)
  payrollRounding          PayrollRounding    @default(ROUND)
  gpsMaxAccuracyMeters     Int                @default(100)
  requireSiteAssignment    Boolean            @default(true)
  checkoutRequiresGeofence Boolean            @default(false)
  maxDocumentSizeMb        Int                @default(5)
  updatedAt                DateTime           @updatedAt

  @@map("organization_policy")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json? // never contains medical content or coordinates
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// Payroll
// ===========================================================================

// deductions = otherDeductions + leaveDeduction + carriedAdjustments
// netSalary  = basicSalary + allowances - deductions
model Payroll {
  id          String        @id @default(cuid())
  employeeId  String
  month       Int // 1-12
  year        Int
  basicSalary Decimal       @db.Decimal(10, 2)
  allowances  Decimal       @default(0) @db.Decimal(10, 2)
  deductions  Decimal       @default(0) @db.Decimal(10, 2)
  netSalary   Decimal       @db.Decimal(10, 2)
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  notes       String?

  // Leave impact breakdown (calculated by the centralized payroll service)
  otherDeductions    Decimal?  @db.Decimal(10, 2) // manual / non-leave deductions
  leaveDeduction     Decimal   @default(0) @db.Decimal(10, 2)
  carriedAdjustments Decimal   @default(0) @db.Decimal(10, 2)
  paidLeaveDays      Float     @default(0)
  unpaidLeaveDays    Float     @default(0)
  medicalLeaveDays   Float     @default(0)
  otherLeaveDays     Float     @default(0)
  dailyRate          Decimal   @default(0) @db.Decimal(10, 2)
  calculatedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  adjustments PayrollAdjustment[] @relation("PayrollAdjustments")

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
  @@map("payrolls")
}

// Explicit correction for an already PROCESSED / PAID payroll whose leave inputs changed.
// amount > 0 = additional deduction, amount < 0 = credit.
model PayrollAdjustment {
  id               String                  @id @default(cuid())
  payrollId        String
  leaveRequestId   String?
  amount           Decimal                 @db.Decimal(10, 2)
  reason           String
  status           PayrollAdjustmentStatus @default(PENDING)
  appliedPayrollId String?
  createdById      String?
  createdAt        DateTime                @default(now())
  appliedAt        DateTime?

  payroll      Payroll       @relation("PayrollAdjustments", fields: [payrollId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)

  @@index([payrollId, status])
  @@index([leaveRequestId])
  @@map("payroll_adjustments")
}

// ===========================================================================
// CRM / Leads
// ===========================================================================

model Lead {
  id            String     @id @default(cuid())
  title         String
  contactName   String
  contactEmail  String?
  contactPhone  String?
  company       String?
  source        LeadSource @default(OTHER)
  status        LeadStatus @default(NEW)
  value         Decimal?   @db.Decimal(10, 2)
  notes         String?
  assignedToId  String?
  createdById   String
  expectedClose DateTime?  @db.Date
  convertedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  assignedTo User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy  User           @relation("CreatedLeads", fields: [createdById], references: [id])
  followUps  LeadFollowUp[]
  client     Client?

  @@index([status])
  @@index([assignedToId])
  @@map("leads")
}

model LeadFollowUp {
  id           String   @id @default(cuid())
  leadId       String
  notes        String
  followUpDate DateTime @db.Date
  isDone       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([followUpDate])
  @@map("lead_follow_ups")
}

// ===========================================================================
// OTP Verification
// ===========================================================================

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

// ===========================================================================
// Shift Management
// ===========================================================================

model Shift {
  id            String    @id @default(cuid())
  name          String    @unique
  startTime     String    // "09:00" 24-hour format
  endTime       String    // "18:00" 24-hour format
  gracePeriodMins Int     @default(15)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments   ShiftAssignment[]

  @@map("shifts")
}

model ShiftAssignment {
  id          String    @id @default(cuid())
  shiftId     String
  employeeId  String
  effectiveFrom DateTime @db.Date
  effectiveUntil DateTime? @db.Date
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isActive])
  @@index([shiftId])
  @@map("shift_assignments")
}

// ===========================================================================
// In-App Notifications
// ===========================================================================

enum NotificationType {
  LEAVE_APPLIED
  LEAVE_APPROVED
  LEAVE_REJECTED
  PAYSLIP_GENERATED
  ATTENDANCE_ALERT
  GENERAL
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType @default(GENERAL)
  title      String
  message    String
  link       String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ===========================================================================
// Employee Invitations
// ===========================================================================

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model EmployeeInvitation {
  id         String           @id @default(cuid())
  email      String           @unique
  name       String?
  role       Role             @default(ENGINEER)
  token      String           @unique @default(cuid())
  status     InvitationStatus @default(PENDING)
  invitedById String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([token])
  @@index([email])
  @@map("employee_invitations")
}

// ===========================================================================
// CRM Additions: Clients & Invoices
// ===========================================================================

model Client {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  company      String?
  address      String?
  leadId       String?  @unique // Link to the original lead
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices     Invoice[]
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@map("clients")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  clientId      String
  amount        Decimal  @db.Decimal(10, 2)
  tax           Decimal? @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime @db.Date
  notes         String?
  pdfUrl        String?  // Cloudinary secure_url for the invoice PDF
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@map("invoices")
}
